{
	"name": "abolition-georgia",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "playwright test",
		"test:unit": "vitest",
		"test:ui": "playwright test --ui",
		"data:update": "node scripts/update-boundaries.mjs ../ga-gms-map",
		"data:refresh": "node scripts/update-boundaries.mjs ../ga-gms-map --refresh && npm run data:regions && npm run data:metrics",
		"data:validate-regions": "node scripts/validate-region-assignment.mjs",
		"data:regions": "node scripts/validate-region-assignment.mjs && node scripts/build-regions.mjs ../ga-gms-map/data/districts.json",
		"data:metrics": "node scripts/build-region-metrics.mjs ../ga-gms-map/data/districts.json",
		"data:check": "node scripts/check-boundary-drift.mjs ../ga-gms-map",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write ."
	},
	"devDependencies": {
		"@playwright/test": "^1.57.0",
		"@sveltejs/adapter-auto": "^7.0.0",
		"@sveltejs/adapter-node": "^5.5.8",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.49.1",
		"@sveltejs/vite-plugin-svelte": "^6.2.1",
		"@tailwindcss/postcss": "^4.1.18",
		"@tailwindcss/vite": "^4.1.18",
		"@testing-library/dom": "^10.4.1",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/svelte": "^5.3.1",
		"@types/better-sqlite3": "^9.6.0",
		"@types/d3-geo": "^3.1.1",
		"@types/geojson": "^7946.0.16",
		"@types/node": "^25.9.9",
		"@typescript-eslint/eslint-plugin": "^7.0.0",
		"@typescript-eslint/parser": "^7.0.0",
		"@vitest/coverage-v8": "^4.0.16",
		"@vitest/ui": "^4.0.16",
		"eslint": "^8.56.0",
		"eslint-config-prettier": "^9.1.0",
		"eslint-plugin-svelte": "^2.35.1",
		"jsdom": "^27.4.0",
		"prettier": "^3.1.1",
		"prettier-plugin-svelte": "^3.1.2",
		"prettier-plugin-tailwindcss": "^0.5.11",
		"shapefile": "^0.6.6",
		"svelte": "^5.45.6",
		"svelte-check": "^4.3.4",
		"tailwindcss": "^4.1.18",
		"typescript": "^5.9.3",
		"vite": "^7.3.2",
		"vitest": "^4.0.17"
	},
	"dependencies": {
		"@neondatabase/serverless": "^1.1.0",
		"@node-rs/argon2": "^2.2.2",
		"@turf/turf": "^7.3.1",
		"@types/leaflet": "^1.9.21",
		"better-sqlite3": "^13.0.3",
		"d3-geo": "^3.1.2",
		"leaflet": "^1.9.4"
	},
	"overrides": {
		"cookie": "^0.7.0"
	}
}
