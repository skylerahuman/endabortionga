# Public display controls (clean UI by default). prd/production forces both flags off.
PUBLIC_SITE_ENV=dev
PUBLIC_SHOW_MAP_DEBUG=false
PUBLIC_SHOW_PREVIEW_LABELS=false

# Movement accounts: local persistent SQLite. Use an absolute private persistent path in production.
DATABASE_PATH=.data/movement-map.sqlite

# Live checkout is intentionally disabled until real provider attribution is verified.
# signed-bridge-v1 is this app's normalized protocol, NOT native Givebutter callbacks.
DONATION_INGESTION_MODE=
DONATION_BRIDGE_SECRET=
GIVEBUTTER_CAMPAIGN_CODE=
GIVEBUTTER_ACCOUNT_ID=
GIVEBUTTER_ATTRIBUTION_VERIFIED=false

# Legacy volunteers API only; movement accounts do NOT use this variable.
DATABASE_URL=
